<rml>
<head>
	<title>Project Settings</title>
	<link type="text/template" href="project_panel.rml"/>
</head>
<body template="project_panel">
	<panel>
		<div class="title-bar">
			<span class="title">Settings</span>
		</div>
		<div class="content">
			<div data-model="Settings">
				<h3>Settings</h3>
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>		
						<tr class="property_tr">
							<td>
								<label><input type="checkbox" name="render_origin_flag" data-checked="render_origin"/>Draw Origin</label>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label><input type="checkbox" name="render_anchor_flag" data-checked="render_anchors"/>Draw Origin</label>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label><input type="checkbox" name="render_stencil_flag" data-checked="render_stencils"/>Draw Origin</label>
							</td>
						</tr>												
						<tr class="property_tr">
							<td>
								<label>Language</label>
								<select id="select" name="select_language" data-value="selected_language_id" data-event-change="select_language_entry()">
									<option data-for="language_id : language_id_list" data-value="language_id">language_id</option>
								</select>
							</td>
						</tr>
					</tbody>
				</table>						
			</div>	
		</div>
	</panel>
</body>
</rml>
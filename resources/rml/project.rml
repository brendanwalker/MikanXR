<rml>
	<head>
		<link type="text/rcss" href="rml.rcss" />
		<link type="text/rcss" href="mikan.rcss" />
		<link type="text/template" href="window.rml" />
		<title>Project</title>
		<style>
			body.window {
				left: 0dp;
				right: 0dp;
				top: -45dp;
				bottom: 0dp;
				max-width: 1280dp;
				max-height: 45dp;
			}     
		</style>
	</head>

	<body template="window">
		<panel id="controls" data-model="project">
			<span>
				<button style="width: 80dp" data-event-click="return">Main Menu</button>
				<button style="width: 120dp" data-event-click="toggle_scenes">Scenes</button>
				<button style="width: 120dp" data-event-click="toggle_stages">Stages</button>
				<button style="width: 120dp" data-event-click="toggle_sources">Sources</button>
				<button style="width: 120dp" data-event-click="toggle_tracking">Tracking</button>
				<button style="width: 120dp" data-event-click="toggle_markers">Markers</button>
				<button style="width: 120dp" data-event-click="toggle_settings">Settings</button>
			</span>
		</panel>
	</body>
</rml>
<rml>
	<head>
	<link type="text/rcss" href="rml.rcss"/>
	<link type="text/rcss" href="mikan.rcss"/>
		<title>Project</title>
		<style>
			body.window {
				position: absolute;
				top: 0;
				right: 0;
				width: 350dp;
				padding-top: 0;
			}

			#main-menu-tab {
				display: block;
				width: 100%;
			}
		</style>
	</head>

	<body template="window">
		<panel id="controls" data-model="project">
			<tabset>
				<tab data-event-click="toggle_scenes">Scenes</tab>
				<tab data-event-click="toggle_stages">Stages</tab>
				<tab data-event-click="toggle_sources">Sources</tab>
				<tab data-event-click="toggle_tracking">Tracking</tab>
				<tab data-event-click="toggle_markers">Markers</tab>
				<tab data-event-click="toggle_settings">Settings</tab>
				<tab id="main-menu-tab" data-event-click="return">Main Menu</tab>
			</tabset>
		</panel>
	</body>
</rml>
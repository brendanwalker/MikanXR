<rml>
<head>
	<title>Project Scenes</title>
	<link type="text/rcss" href="rml.rcss"/>
	<link type="text/rcss" href="mikan.rcss"/>
</head>
<body template="window">
	<panel>
		<div class="title-bar">
			<span class="title">Scenes</span>
		</div>

		<div class="content">
			<!-- Stages Section -->
			<div data-model="Scenes">
				<h3>Stages</h3>
				<select id="select" name="select_stage_id" data-value="selected_stage_id" data-event-change="select_stage_entry()">
					<option data-for="stage_id : stage_ids" data-value="stage_id">{{stage_id | to_stage_name}}</option>
				</select>				
			</div>
			
			<!-- Scene Section -->
			<div data-model="Scenes">
				<h3>Scene</h3>
				<select id="select" name="select_scene_id" data-value="selected_scene_id" data-event-change="select_scene_entry()">
					<option data-for="scene_id : scene_ids" data-value="scene_id">{{scene_id | to_scene_name}}</option>
				</select>			
				<createcomponent data-event-click="add_new_scene"></createcomponent>
				<deletecomponent data-event-click="remove_scene"></deletecomponent>
			</div>
			<div data-if="component_id != -1" data-model="SceneComponent">
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>
						<tr class="property_tr">
							<td>
								Name&nbsp;
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="component_name"/>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								Compositor&nbsp;
								<select id="select" name="select_compositor_id" data-value="display_compositor_id" data-event-change="select_compositor_entry()">
									<option data-for="compositor_id : compositor_ids" data-value="compositor_id">{{compositor_id | to_compositor_name}}</option>
								</select>	
								<createcomponent data-event-click="add_compositor_ref()"></createcomponent>
								<deletecomponent data-event-click="remove_compositor_ref()"></deletecomponent>						
							</td>
						</tr>												
						<tr class="property_tr">
							<td>
								Script&nbsp;
								<filename>{{component_script | to_short_path(30)}}</filename>
								<editcomponent data-event-click="reload_script()"></editcomponent>
								<createcomponent data-event-click="add_new_script()"></createcomponent>
								<deletecomponent data-event-click="remove_script()"></deletecomponent>						
							</td>
						</tr>						
					</tbody>
				</table>
				<br/>
				<div data-for="script_trigger : script_triggers">
					<button data-event-click="invoke_script_trigger(script_trigger)">{{script_trigger}}</button>
				</div>				
			</div>

			<!-- Scene Outliner -->
			<panel id="scene_outliner" data-model="Scenes">            
				<h3>Actors</h3>
				<div>
					<button style="width: 80dp; height: 67dp; margin-right: -5dp;" data-event-click="add_new_anchor()"><img sprite="icon-anchor"/></button>
					<button style="width: 80dp; height: 67dp; margin-right: -5dp;" data-event-click="add_new_quad()"><img sprite="icon-quad"/></button>
					<button style="width: 80dp; height: 67dp; margin-right: -5dp;" data-event-click="add_new_box()"><img sprite="icon-box"/></button>
					<button style="width: 80dp; height: 67dp; margin-right: -5dp;" data-event-click="add_new_model()"><img sprite="icon-model"/></button>
				</div>
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 10dp;"></td></tr>
					</thead>
					<tbody>
						<tr data-for="object : scene_objects">
							<td>
								<spacer data-style-width="25 * object.depth + 'dp'"/>
								<label data-if="it_index != selection_index" data-event-click="select_object_entry(it_index)">{{ object.name }}</label>
								<highlight_label data-if="it_index == selection_index">{{ object.name }}</highlight_label>
							</td>
						</tr>
					</tbody>
				</table>
			</panel>

			<!-- Anchor Component Properties -->
			<div data-if="component_id != -1" data-model="AnchorComponent">
				<h5>Anchor</h5>
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>
						<tr class="property_tr">
							<td>
								Name&nbsp;
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="component_name"/>
								<deletecomponent data-event-click="delete_anchor"></deletecomponent>
							</td>
						</tr>
						<tr class="property_tr">	
							<td>
								Position&nbsp;
								<numeric type="float" precision="3" min="-10.0" max="10.0" step="0.001" data-value="relative_position_x"/>
								<numeric type="float" precision="3" min="-10.0" max="10.0" step="0.001" data-value="relative_position_y"/>
								<numeric type="float" precision="3" min="-10.0" max="10.0" step="0.001" data-value="relative_position_z"/>                                
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								Rotation&nbsp;
								<numeric type="float" precision="1" min="-180.0" max="180.0" step="0.5" data-value="relative_rotation_x"/>
								<numeric type="float" precision="1" min="-180.0" max="180.0" step="0.5" data-value="relative_rotation_y"/>
								<numeric type="float" precision="1" min="-180.0" max="180.0" step="0.5" data-value="relative_rotation_z"/>                                
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								Scale&nbsp;
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="relative_scale_x"/>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="relative_scale_y"/>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="relative_scale_z"/>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								Cull Mode&nbsp;
								<select id="select" name="cull_mode_list" data-value="cull_mode" data-event-change="select_cull_mode_entry()" style="width: 200dp; vertical-align: -12dp">
									<option data-for="enum_value : stencil_cull_mode_values" data-value="enum_value">{{enum_value | to_enum_string('stencil_cull_mode')}}</option>
								</select>
							</td>
						</tr>						
						<tr class="property_tr">
							<td>
								<button data-event-click="edit_anchor()">Align Anchor</button>
							</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Box Stencil Component Properties -->
			<div data-if="component_id != -1" data-model="StencilComponent">
				<h5>Box Stencil</h5>
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>
						<tr class="property_tr">
							<td>
								Name&nbsp;
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="component_name"/>
								<deletecomponent data-event-click="delete_anchor"></deletecomponent>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								Anchor&nbsp;
								<select id="select" name="select_anchor_id" data-value="parent_anchor_id" data-event-change="select_anchor_entry()">
									<option data-for="anchor_id : anchor_ids" data-value="anchor_id">{{anchor_id | to_anchor_name}}</option>
								</select>
							</td>
						</tr>						
						<tr class="property_tr">	
							<td>
								Position&nbsp;
								<numeric type="float" precision="3" min="-10.0" max="10.0" step="0.001" data-value="relative_position_x"/>
								<numeric type="float" precision="3" min="-10.0" max="10.0" step="0.001" data-value="relative_position_y"/>
								<numeric type="float" precision="3" min="-10.0" max="10.0" step="0.001" data-value="relative_position_z"/>                                
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								Rotation&nbsp;
								<numeric type="float" precision="1" min="-180.0" max="180.0" step="0.5" data-value="relative_rotation_x"/>
								<numeric type="float" precision="1" min="-180.0" max="180.0" step="0.5" data-value="relative_rotation_y"/>
								<numeric type="float" precision="1" min="-180.0" max="180.0" step="0.5" data-value="relative_rotation_z"/>                                
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								Scale&nbsp;
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="relative_scale_x"/>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="relative_scale_y"/>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="relative_scale_z"/>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								Box Size&nbsp;
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="box_x_size"/>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="box_y_size"/>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="box_z_size"/>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								Cull Mode&nbsp;
								<select id="select" name="cull_mode_list" data-value="cull_mode" data-event-change="select_cull_mode_entry()" style="width: 200dp; vertical-align: -12dp">
									<option data-for="enum_value : stencil_cull_mode_values" data-value="enum_value">{{enum_value | to_enum_string('stencil_cull_mode')}}</option>
								</select>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label><input type="checkbox" name="stencil_disable_flag" data-checked="is_disabled" />Disabled</label>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<button data-event-click="edit_anchor()">Align Anchor</button>
							</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Model Stencil Component Properties -->
			<div data-if="component_id != -1" data-model="StencilComponent">
				<h5>Model Stencil</h5>
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>
						<tr class="property_tr">
							<td>
								Name&nbsp;
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="component_name"/>
								<deletecomponent data-event-click="delete_anchor"></deletecomponent>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								Anchor&nbsp;
								<select id="select" name="select_anchor_id" data-value="parent_anchor_id" data-event-change="select_anchor_entry()">
									<option data-for="anchor_id : anchor_ids" data-value="anchor_id">{{anchor_id | to_anchor_name}}</option>
								</select>
							</td>
						</tr>						
						<tr class="property_tr">	
							<td>
								Position&nbsp;
								<numeric type="float" precision="3" min="-10.0" max="10.0" step="0.001" data-value="relative_position_x"/>
								<numeric type="float" precision="3" min="-10.0" max="10.0" step="0.001" data-value="relative_position_y"/>
								<numeric type="float" precision="3" min="-10.0" max="10.0" step="0.001" data-value="relative_position_z"/>                                
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								Rotation&nbsp;
								<numeric type="float" precision="1" min="-180.0" max="180.0" step="0.5" data-value="relative_rotation_x"/>
								<numeric type="float" precision="1" min="-180.0" max="180.0" step="0.5" data-value="relative_rotation_y"/>
								<numeric type="float" precision="1" min="-180.0" max="180.0" step="0.5" data-value="relative_rotation_z"/>                                
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								Scale&nbsp;
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="relative_scale_x"/>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="relative_scale_y"/>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="relative_scale_z"/>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								Model&nbsp;
								<filename>{{model_path | to_short_path(30)}}</filename>
								<createcomponent data-event-click="add_new_model()"></createcomponent>
								<deletecomponent data-event-click="remove_model()"></deletecomponent>						
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								Cull Mode&nbsp;
								<select id="select" name="cull_mode_list" data-value="cull_mode" data-event-change="select_cull_mode_entry()" style="width: 200dp; vertical-align: -12dp">
									<option data-for="enum_value : stencil_cull_mode_values" data-value="enum_value">{{enum_value | to_enum_string('stencil_cull_mode')}}</option>
								</select>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label><input type="checkbox" name="stencil_disable_flag" data-checked="is_disabled" />Disabled</label>
							</td>
						</tr>		
						<tr class="property_tr">
							<td>
								<button data-event-click="edit_anchor()">Align Anchor</button>
							</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Quad Stencil Component Properties -->
			<div data-if="component_id != -1" data-model="StencilComponent">
				<h5>Quad Stencil</h5>
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>
						<tr class="property_tr">
							<td>
								Name&nbsp;
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="component_name"/>
								<deletecomponent data-event-click="delete_anchor"></deletecomponent>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								Anchor&nbsp;
								<select id="select" name="select_anchor_id" data-value="parent_anchor_id" data-event-change="select_anchor_entry()">
									<option data-for="anchor_id : anchor_ids" data-value="anchor_id">{{anchor_id | to_anchor_name}}</option>
								</select>
							</td>
						</tr>						
						<tr class="property_tr">	
							<td>
								Position&nbsp;
								<numeric type="float" precision="3" min="-10.0" max="10.0" step="0.001" data-value="relative_position_x"/>
								<numeric type="float" precision="3" min="-10.0" max="10.0" step="0.001" data-value="relative_position_y"/>
								<numeric type="float" precision="3" min="-10.0" max="10.0" step="0.001" data-value="relative_position_z"/>                                
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								Rotation&nbsp;
								<numeric type="float" precision="1" min="-180.0" max="180.0" step="0.5" data-value="relative_rotation_x"/>
								<numeric type="float" precision="1" min="-180.0" max="180.0" step="0.5" data-value="relative_rotation_y"/>
								<numeric type="float" precision="1" min="-180.0" max="180.0" step="0.5" data-value="relative_rotation_z"/>                                
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								Scale&nbsp;
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="relative_scale_x"/>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="relative_scale_y"/>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="relative_scale_z"/>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								Quad Size&nbsp;
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="quad_width"/>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="quad_height"/>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label><input type="checkbox" name="stencil_disable_flag" data-checked="is_disabled" />Disabled</label>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label><input type="checkbox" name="stencil_double_sided_flag" data-checked="is_double_sided" />Double Sided</label>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<button data-event-click="edit_anchor()">Align Anchor</button>
							</td>
						</tr>
					</tbody>
				</table>
			</div>	
		</div>
	</panel>
</body>
</rml>
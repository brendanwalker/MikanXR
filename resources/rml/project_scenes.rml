<rml>
<head>
	<title>Project Scenes</title>
	<link type="text/template" href="project_panel.rml"/>
</head>
<body template="project_panel">
	<panel>
		<div class="content">		
			<!-- Scene Section -->
			<div data-model="Scenes">
				<h3>Scene</h3>
				<select id="select" name="select_scene_id" data-value="selected_scene_id" data-event-change="select_scene_entry()">
					<option value="-1">-- None --</option>
					<option data-for="scene_id : SceneComponentIdList" data-value="scene_id">{{scene_id | to_scene_name}}</option>
				</select>			
				<div class="createcomponent" data-event-click="add_new_scene"></div>
				<div class="deletecomponent" data-event-click="remove_scene"></div>
			</div>
			<div data-if="component_id != -1" data-model="SceneComponent">
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>
						<tr class="property_tr">
							<td>
								<label>Name</label>
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="component_name"/>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Compositor</label>
								<select id="select" name="select_compositor_id" data-value="display_compositor_id" data-event-change="select_compositor_entry()">
									<option value="-1">-- None --</option>
									<option data-for="compositor_id : compositor_ids" data-value="compositor_id">{{compositor_id | to_compositor_name}}</option>
								</select>	
							</td>
						</tr>												
						<tr class="property_tr">
							<td>
								<label>Script</label>
								<filename>{{component_script | to_short_path(30)}}</filename>
								<div class="editcomponent" data-event-click="reload_script()"></div>
								<div class="createcomponent" data-event-click="add_new_script()"></div>
								<div class="deletecomponent" data-event-click="remove_script()"></div>						
							</td>
						</tr>						
					</tbody>
				</table>
				<br/>
				<div data-for="script_trigger : script_triggers">
					<button data-event-click="invoke_script_trigger(script_trigger)">{{script_trigger}}</button>
				</div>				
			</div>

			<!-- Compositors Section-->
			<div data-if="selected_scene_id != -1" data-model="Scenes">
				<h3>Compositors</h3>
				<select id="select" name="select_compositor_id" data-value="selected_compositor_id" data-event-change="select_compositor_entry()">
					<option value="-1">-- None --</option>
					<option data-for="compositor_id : compositor_ids" data-value="compositor_id">{{compositor_id | to_compositor_name}}</option>
				</select>			
				<div class="createcomponent" data-event-click="add_new_compositor"></div>
				<div class="deletecomponent" data-if="selected_compositor_id != -1" data-event-click="remove_compositor"></div>
			</div>
			<div data-if="component_id != -1" data-model="CompositorComponent">
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>
						<tr class="property_tr">
							<td>
								<label>Name</label>
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="component_name"/>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Camera</label>
								<select id="select" name="select_camera_id" data-value="camera_id" data-event-change="select_camera_entry()">
									<option data-for="element_id : CameraComponentIdList" data-value="element_id">{{element_id | to_camera_name}}</option>
								</select>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label><input type="checkbox" name="spout_output_flag" data-checked="spout_enable_output" />Enable Spout Output</label>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Output Name</label>
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="spout_output_name"/>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<filename>{{compositor_graph_path | to_short_path(30)}}</filename>
								<div class="editcomponent" data-event-click="edit_compositor_graph()"></div>
								<div class="createcomponent" data-event-click="add_new_compositor_graph()"></div>
								<div class="deletecomponent" data-event-click="remove_compositor_graph()"></div>						
							</td>
						</tr>
					</tbody>
				</table>
			</div>	

			<!-- Scene Outliner -->
			<panel id="scene_outliner" data-if="selected_scene_id != -1" data-model="Scenes">            
				<h3>Actors</h3>
				<div>
					<button class="icon-button" data-event-click="add_new_anchor()"><img sprite="icon-anchor"/></button>
					<button class="icon-button" data-event-click="add_new_quad()"><img sprite="icon-quad"/></button>
					<button class="icon-button" data-event-click="add_new_box()"><img sprite="icon-box"/></button>
					<button class="icon-button" data-event-click="add_new_model()"><img sprite="icon-model"/></button>
				</div>
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 10dp;"></td></tr>
					</thead>
					<tbody>
						<tr data-for="object : scene_objects">
							<td>
								<spacer data-style-width="25 * object.depth + 'dp'"/>
								<label data-if="it_index != selected_scene_object_index" data-event-click="select_object_entry(it_index)">{{ object.name }}</label>
								<highlight_label data-if="it_index == selected_scene_object_index">{{ object.name }}</highlight_label>
							</td>
						</tr>
					</tbody>
				</table>
			</panel>

			<!-- Anchor Component Properties -->
			<div data-if="component_id != -1" data-model="AnchorComponent">
				<h5>Anchor</h5>
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>
						<tr class="property_tr">
							<td>
								<label>Name</label>
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="component_name"/>
								<div class="deletecomponent" data-event-click="remove_anchor"></div>
							</td>
						</tr>
						<tr class="property_tr">	
							<td>
								<label>Position</label>
								<numeric type="float" precision="3" min="-10.0" max="10.0" step="0.001" data-value="relative_position_x"/>
								<numeric type="float" precision="3" min="-10.0" max="10.0" step="0.001" data-value="relative_position_y"/>
								<numeric type="float" precision="3" min="-10.0" max="10.0" step="0.001" data-value="relative_position_z"/>                                
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Rotation</label>
								<numeric type="float" precision="1" min="-180.0" max="180.0" step="0.5" data-value="relative_rotation_x"/>
								<numeric type="float" precision="1" min="-180.0" max="180.0" step="0.5" data-value="relative_rotation_y"/>
								<numeric type="float" precision="1" min="-180.0" max="180.0" step="0.5" data-value="relative_rotation_z"/>                                
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Scale</label>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="relative_scale_x"/>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="relative_scale_y"/>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="relative_scale_z"/>
							</td>
						</tr>					
						<tr class="property_tr">
							<td>
								<button data-event-click="edit_anchor()">Align Anchor</button>
							</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Box Stencil Component Properties -->
			<div data-if="component_id != -1" data-model="BoxStencilComponent">
				<h5>Box Stencil</h5>
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>
						<tr class="property_tr">
							<td>
								<label>Name</label>
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="component_name"/>
								<div class="deletecomponent" data-event-click="remove_box"></div>
							</td>
						</tr>
						<tr class="property_tr">	
							<td>
								<label>Position</label>
								<numeric type="float" precision="3" min="-10.0" max="10.0" step="0.001" data-value="relative_position_x"/>
								<numeric type="float" precision="3" min="-10.0" max="10.0" step="0.001" data-value="relative_position_y"/>
								<numeric type="float" precision="3" min="-10.0" max="10.0" step="0.001" data-value="relative_position_z"/>                                
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Rotation</label>
								<numeric type="float" precision="1" min="-180.0" max="180.0" step="0.5" data-value="relative_rotation_x"/>
								<numeric type="float" precision="1" min="-180.0" max="180.0" step="0.5" data-value="relative_rotation_y"/>
								<numeric type="float" precision="1" min="-180.0" max="180.0" step="0.5" data-value="relative_rotation_z"/>                                
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Scale</label>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="relative_scale_x"/>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="relative_scale_y"/>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="relative_scale_z"/>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Box Size</label>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="box_x_size"/>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="box_y_size"/>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="box_z_size"/>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Cull Mode</label>
								<select id="select" name="cull_mode_list" data-value="cull_mode" data-event-change="select_cull_mode_entry()" style="width: 200dp; vertical-align: -12dp">
									<option data-for="enum_value : stencil_cull_mode_values" data-value="enum_value">{{enum_value | to_enum_string('stencil_cull_mode')}}</option>
								</select>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label><input type="checkbox" name="stencil_disable_flag" data-checked="is_disabled" />Disabled</label>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<button data-event-click="edit_anchor()">Align Anchor</button>
							</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Model Stencil Component Properties -->
			<div data-if="component_id != -1" data-model="ModelStencilComponent">
				<h5>Model Stencil</h5>
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>
						<tr class="property_tr">
							<td>
								<label>Name</label>
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="component_name"/>
								<div class="deletecomponent" data-event-click="remove_model"></div>
							</td>
						</tr>
						<tr class="property_tr">	
							<td>
								<label>Position</label>
								<numeric type="float" precision="3" min="-10.0" max="10.0" step="0.001" data-value="relative_position_x"/>
								<numeric type="float" precision="3" min="-10.0" max="10.0" step="0.001" data-value="relative_position_y"/>
								<numeric type="float" precision="3" min="-10.0" max="10.0" step="0.001" data-value="relative_position_z"/>                                
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Rotation</label>
								<numeric type="float" precision="1" min="-180.0" max="180.0" step="0.5" data-value="relative_rotation_x"/>
								<numeric type="float" precision="1" min="-180.0" max="180.0" step="0.5" data-value="relative_rotation_y"/>
								<numeric type="float" precision="1" min="-180.0" max="180.0" step="0.5" data-value="relative_rotation_z"/>                                
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Scale</label>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="relative_scale_x"/>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="relative_scale_y"/>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="relative_scale_z"/>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Model</label>
								<filename>{{model_path | to_short_path(30)}}</filename>
								<div class="createcomponent" data-event-click="add_new_model()"></div>
								<div class="deletecomponent" data-event-click="remove_model()"></div>						
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Cull Mode</label>
								<select id="select" name="cull_mode_list" data-value="cull_mode" data-event-change="select_cull_mode_entry()" style="width: 200dp; vertical-align: -12dp">
									<option data-for="enum_value : stencil_cull_mode_values" data-value="enum_value">{{enum_value | to_enum_string('stencil_cull_mode')}}</option>
								</select>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label><input type="checkbox" name="stencil_disable_flag" data-checked="is_disabled" />Disabled</label>
							</td>
						</tr>		
						<tr class="property_tr">
							<td>
								<button data-event-click="edit_anchor()">Align Anchor</button>
							</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Quad Stencil Component Properties -->
			<div data-if="component_id != -1" data-model="QuadStencilComponent">
				<h5>Quad Stencil</h5>
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>
						<tr class="property_tr">
							<td>
								<label>Name</label>
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="component_name"/>
								<div class="deletecomponent" data-event-click="remove_quad"></div>
							</td>
						</tr>
						<tr class="property_tr">	
							<td>
								<label>Position</label>
								<numeric type="float" precision="3" min="-10.0" max="10.0" step="0.001" data-value="relative_position_x"/>
								<numeric type="float" precision="3" min="-10.0" max="10.0" step="0.001" data-value="relative_position_y"/>
								<numeric type="float" precision="3" min="-10.0" max="10.0" step="0.001" data-value="relative_position_z"/>                                
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Rotation</label>
								<numeric type="float" precision="1" min="-180.0" max="180.0" step="0.5" data-value="relative_rotation_x"/>
								<numeric type="float" precision="1" min="-180.0" max="180.0" step="0.5" data-value="relative_rotation_y"/>
								<numeric type="float" precision="1" min="-180.0" max="180.0" step="0.5" data-value="relative_rotation_z"/>                                
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Scale</label>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="relative_scale_x"/>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="relative_scale_y"/>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="relative_scale_z"/>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Quad Size</label>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="quad_width"/>
								<numeric type="float" precision="2" min="0.0" max="10.0" step="0.01" data-value="quad_height"/>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label><input type="checkbox" name="stencil_disable_flag" data-checked="is_disabled" />Disabled</label>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label><input type="checkbox" name="stencil_double_sided_flag" data-checked="is_double_sided" />Double Sided</label>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<button data-event-click="edit_anchor()">Align Anchor</button>
							</td>
						</tr>
					</tbody>
				</table>
			</div>	
		</div>
	</panel>
</body>
</rml>
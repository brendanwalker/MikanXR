<rml>
	<head>
		<link type="text/rcss" href="rml.rcss"/>
		<link type="text/rcss" href="mikan.rcss"/>
		<link type="text/template" href="window.rml" />
		<title>Demo Sample</title>
		<style>
			@keyframes slideout {
				from {
					opacity: 1;
					transform: translateX(0dp);
					visibility: visible;
				}
				to {
					opacity: 0;
					transform: translateX(300dp);
					visibility: hidden;
				}
			}
			@keyframes slidein {
				from {
					opacity: 0;
					transform: translateX(300dp);
					visibility: hidden;
				}
				to {
					opacity: 1;
					transform: translateX(0dp);
					visibility: visible;
				}
			}
			body
			{
				width: 400dp;
				height: 300dp;

				margin: auto;
				animation: 0.25s cubic-out slidein;
			}
			button {
				transition: transform 0.25s elastic-out;
				transform: scale(1.0);
			}
			button:hover {
				transform: scale(1.1);
			}

		</style>
	</head>
	<body template="window" data-model="MainMenu">
		<div id="title_bar">
			<handle move_target="#document">
				<div id="icon"></div>
				<span id="title">Main Menu</span>
			</handle>
		</div>
		<div style="height: 40dp" />
		<div data-if="has_existing_project">
			<button data-event-click="resume_project">Resume Project</button>
		</div>
		<div>
			<button data-event-click="open_project">Open Project</button>
		</div>
		<div>
			<button data-event-click="new_project">New Project</button>
		</div>
		<div>
			<button data-event-click="launch_tutorial">Tutorial</button>
		</div>
		<div>
			<button data-event-click="exit">Exit</button>
		</div>
	</body>
</rml>
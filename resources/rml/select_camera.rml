<rml>
	<head>
		<link type="text/rcss" href="rml.rcss"/>
		<link type="text/rcss" href="mikan.rcss"/>
		<link type="text/template" href="window.rml" />
		<title>Select Camera</title>
		<style>
			body {
				width: 600dp;
				height: 500dp;
				margin: auto;
			}
			
			/* Hide the window icon. */
			div#title_bar div#icon {
				display: none;
			}
			
			spacer {
				display: inline-block;
			}
			expand {
				display: inline-block;
				vertical-align: -3dp;
				margin-right: 2dp;
			}
			tbody tr {
				height: 1.5em;
			}
			tbody td
			{
				padding-top: 0.1em;
				height: 1.5em;
				text-align: left;
				white-space: nowrap;
				overflow: hidden;
			}
            .filename-box
            {
                margin-top: 5dp;
                decorator: gradient( vertical #415857 #5990A3 );
                border: 3dp #415857;
                border-radius: 8dp;
            }
            filename
            {
                font-size: 14dp;
                vertical-align: -5dp;
            }			
		</style>
	</head>
	<body template="window">
		<panel id="controls" data-model="select_camera">	
			<h2>Select Calibration Camera</h2>
			<select id="select" name="camera_list" data-value="selected_camera_id" data-event-change="camera_id_changed()" style="width: 200dp">
				<option data-for="camera_id : camera_id_list" data-value="camera_id">{{camera_id | to_camera_name}}</option>
			</select>
			<br/>
			<button data-event-click="ok_action()">ok</button>
			<button data-event-click="cancel_action()">cancel</button>
		</panel>
	</body>
</rml>
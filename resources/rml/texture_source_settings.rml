<rml>
<head>
	<link type="text/rcss" href="rml.rcss"/>
	<link type="text/rcss" href="mikan.rcss"/>
	<style>
		body {
			position: absolute;
			top: 0;
			right: 0;
			bottom: 0;
			width: 350dp;
		}

		#header-buttons {
			display: block;
			width: auto;
			padding: 10dp;
			margin-bottom: 10dp;
			decorator: tiled-box(
				window-tl, window-t, window-tr,
				window-l, window-c, window-r,
				window-bl, window-b, window-br
			);
		}

		#window {
			position: absolute;
			top: 100dp;
			bottom: 0;
			left: 0;
			right: 0;
		}

		#content {
			height: 100%;
			overflow: hidden auto;
		}
	</style>
</head>
<body>
  <div id="header-buttons" data-model="TextureSourceSettings">
    <button data-event-click="return()">Return</button>
  </div>
	<div id="window">
		<div class="content">
			<!-- Client Texture Source Properties -->
			<div data-if="component_id != -1" data-model="ClientTextureSourceComponent">
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>
						<tr class="property_tr">
							<td>
								<label>Name</label>
								<label>{{component_name}}</label>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Source</label>
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="client_source"/>
							</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Spout Texture Source Properties -->
			<div data-if="component_id != -1" data-model="SpoutTextureSourceComponent">
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>
						<tr class="property_tr">
							<td>
								<label>Name</label>
								<label>{{component_name}}</label>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Source</label>
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="spout_source"/>
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
	</div>
</body>
</rml>


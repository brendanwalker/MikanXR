<rml>
<head>
	<title>Project Tracking</title>
	<link type="text/template" href="project_panel.rml"/>
</head>
<body template="project_panel">
	<panel>
		<div class="content">
			<!-- Volumes Section -->
			<div data-model="TrackingSystems">
				<h1>Add Tracking Volume</h1>
				<button class="icon-button" data-event-click="add_new_steamvr_tracking_volume()"><img sprite="icon-steamvr"/></button>
				<button class="icon-button" data-event-click="add_new_marker_tracking_volume()"><img sprite="icon-aruco"/></button>
				<h1>Tracking Volume</h1>
				<select id="select" name="select_volume_id" data-value="selected_tracking_volume_id" data-event-change="select_tracking_volume_entry()">
					<option value="-1">-- None --</option>
					<option data-for="volume_id : tracker_volume_ids" data-value="volume_id">Tracking Volume {{volume_id}}</option>
				</select>
				<div data-if="selected_tracking_volume_id != -1" class="deletecomponent" data-event-click="remove_tracking_volume()"></div>
			</div>
			<div data-if="component_id != -1" data-model="VRTrackingVolumeComponent">
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>
						<tr class="property_tr">
							<td>
								<label>Volume Name</label>
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="component_name"/>
							</td>
						</tr>				
						<tr class="property_tr">
							<td>
								<label>Mount</label>
								<select id="select" name="select_charuco_mount" data-value="charuco_mount_id" data-event-change="select_charuco_mount_entry()">
									<option value="-1">-- None --</option>
									<option data-for="mount_id : tracking_mount_ids" data-value="mount_id">{{mount_id | to_tracking_mount_name}}</option>
								</select>
							</td>
						</tr>
						<tr class="property_tr">	
							<td>
								<label>Mount Offset</label>
								<numeric type="float" precision="1" min="-100.0" max="100.0" step="0.1" data-value="charuco_mount_offset_mm_x"/>
								<numeric type="float" precision="1" min="-100.0" max="100.0" step="0.1" data-value="charuco_mount_offset_mm_y"/>
								<numeric type="float" precision="1" min="-100.0" max="100.0" step="0.1" data-value="charuco_mount_offset_mm_z"/>                                
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Utility Marker</label>
								<select id="select" name="select_utility_marker" data-value="utility_marker_id" data-event-change="select_utility_marker_entry()">
									<option value="-1">-- None --</option>
									<option data-for="marker_id : marker_component_ids" data-value="marker_id">{{marker_id | to_marker_name}}</option>
								</select>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Origin Marker</label>
								<select id="select" name="select_origin_marker" data-value="origin_marker_id" data-event-change="select_origin_marker_entry()">
									<option value="-1">-- None --</option>
									<option data-for="marker_id : marker_component_ids" data-value="marker_id">{{marker_id | to_marker_name}}</option>
								</select>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<button data-event-click="align_tracking_volume()">Align Tracking Volume</button>
							</td>
						</tr>
					</tbody>
				</table>
			</div>
			<div data-if="component_id != -1" data-model="MarkerTrackingVolumeComponent">
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>
						<tr class="property_tr">
							<td>
								<label>Volume Name</label>
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="component_name"/>
							</td>
						</tr>				
						<tr class="property_tr">
							<td>
								<label>Origin Marker</label>
								<select id="select" name="select_origin_marker" data-value="origin_marker_id" data-event-change="select_origin_marker_entry()">
									<option value="-1">-- None --</option>
									<option data-for="marker_id : marker_component_ids" data-value="marker_id">{{marker_id | to_marker_name}}</option>
								</select>
							</td>
						</tr>
					</tbody>
				</table>
			</div>
			
			<!-- Tracking Mounts Section -->
			<div data-if="is_vr_tracking_volume" data-model="TrackingSystems">
				<h1>Tracking Mounts</h1>
				<select id="select" name="select_mount_id" data-value="selected_tracking_mount_id" data-event-change="select_tracking_mount_entry()">
					<option value="-1">-- None --</option>
					<option data-for="mount_id : tracking_mount_ids" data-value="mount_id">Tracking Mount {{mount_id}}</option>
				</select>
				<div class="createcomponent" data-event-click="add_new_tracking_mount()"></div>
				<div class="deletecomponent" data-event-click="remove_tracking_mount()"></div>
			</div>
			<div data-if="component_id != -1" data-model="TrackingMountComponent">
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>
						<tr class="property_tr">
							<td>
								<label>Name</label>
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="component_name"/>
							</td>
						</tr>				
						<tr class="property_tr">
							<td>
								<label>Device</label>
								<select id="select" name="select_device" data-value="device_path" data-event-change="select_device_entry()">
									<option value="">-- None --</option>
									<option data-for="vr_device_path : vr_device_paths" data-value="vr_device_path">{{vr_device_path | to_vr_device_friendly_name}}</option>
								</select>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Socket</label>
								<select id="select" name="select_socket" data-value="socket_name" data-event-change="select_socket_entry()">
									<option value="">-- None --</option>
									<option data-for="vr_socket_name : socket_names" data-value="vr_socket_name">{{vr_socket_name}}</option>
								</select>
							</td>
						</tr>
					</tbody>
				</table>
			</div>

		</div>
	</panel>
</body>
</rml>
<rml>
<head>
	<title>Project Markers</title>
	<link type="text/rcss" href="rml.rcss"/>
	<link type="text/rcss" href="mikan.rcss"/>
	<style>
		body {
			position: absolute;
			right: 0;
			width: 350dp;
		}
	</style>
</head>
<body template="window">
	<panel>
		<div class="title-bar">
			<span class="title">Markers</span>
		</div>
		<div class="content">
			<!-- Markers Section -->
			<div data-model="Markers">
				<h3>Markers</h3>
				<select id="select" name="select_marker_id" data-value="selected_marker_id" data-event-change="select_marker_entry()">
					<option data-for="marker_id : marker_ids" data-value="marker_id">{{marker_id | to_marker_name}}</option>
				</select>				
				<createcomponent data-event-click="add_new_marker"></createcomponent>				
				<deletecomponent data-event-click="remove_marker"></deletecomponent>
			</div>
			<div data-if="component_id != -1" data-model="MarkerComponent">
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>
						<tr class="property_tr">
							<td>
								Name&nbsp;
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="component_name"/>
							</td>
						</tr>				
	                    <tr class="property_tr">
							<td>
								<label style="vertical-align: 12dp;">ArUco Number</label>
								<select id="select" name="select_aruco_id" data-value="aruco_id" data-event-change="select_aruco_id_entry()">
									<option data-for="arucoId : arucoIdList" data-value="arucoId">{{arucoId}}</option>
								</select>
							</td>
						</tr>
	                    <tr class="property_tr">
							<td>
								<div id="aruco_preview" style="width: 115px; height: 115px; display: inline-block;"></div>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<button data-event-click="print_marker()">Print</button>
							</td>
						</tr>
					</tbody>
				</table>
			</div>
			<div data-if="component_id == -1" data-model="MarkerComponent">
				<p>No stage selected</p>
			</div>			

			<!-- Aruco Settings -->
			<div data-model="MarkerObjectSystem">
				<h3>ArUco Settings</h3>
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>		
	                    <tr class="property_tr">
							<td>
								<label style="vertical-align: 12dp;">ArUco Number</label>
								<select id="select" name="select_aruco_dict" data-value="arucoDictionaryType" data-event-change="select_aruco_dictionary()">
									<option data-for="enum_value : marker_dictionary_type_values" data-value="enum_value">{{enum_value | to_enum_string('marker_dictionary_type')}}</option>
								</select>
							</td>
						</tr>
					</tbody>
				</table>						
			</div>			
			
			<!-- Charuco Settings -->
			<div data-model="MarkerObjectSystem">
				<h3>ChArUco Settings</h3>
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>		
						<tr class="property_tr">
							<td>
								ArUco Number&nbsp;
								<select id="select" name="select_aruco_dict" data-value="charucoDictionaryType" data-event-change="select_charuco_dictionary()">
									<option data-for="enum_value : marker_dictionary_type_values" data-value="enum_value">{{enum_value | to_enum_string('marker_dictionary_type')}}</option>
								</select>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								Rows&nbsp;
								<select name="select_row" data-value="charucoRows" data-event-change="select_charuco_rows()">
									<option value="4">4</option>
									<option value="5">5</option>
									<option value="6">6</option>
									<option value="7">7</option>
									<option value="8">8</option>
									<option value="9">9</option>
									<option value="10">10</option>
									<option value="11">11</option>
									<option value="12">12</option>
									<option value="13">13</option>
									<option value="14">14</option>
									<option value="15">15</option>
								</select>
								Cols&nbsp;
								<select name="select_col" data-value="charucoCols" data-event-change="select_charuco_cols()">
									<option value="4">4</option>
									<option value="5">5</option>
									<option value="6">6</option>
									<option value="7">7</option>
									<option value="8">8</option>
									<option value="9">9</option>
									<option value="10">10</option>
									<option value="11">11</option>
									<option value="12">12</option>
									<option value="13">13</option>
									<option value="14">14</option>
									<option value="15">15</option>
								</select>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								Square Length&nbsp;
								<input type="text" style="width: 50dp; margin-left: 0; vertical-align: -2dp;" data-value="charucoSquareLengthMM"/>
								&nbsp;MM
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								Marker Length&nbsp;
								<input type="text" style="width: 50dp; margin-left: 0; vertical-align: -2dp;" data-value="charucoMarkerLengthMM"/>
								&nbsp;MM
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<button data-event-click="print_checkerboard()">Print</button>
							</td>
						</tr>
					</tbody>
				</table>						
			</div>	
		</div>
	</panel>
</body>
</rml>
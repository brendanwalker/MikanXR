<rml>
<head>
	<title>Project Sources</title>
	<link type="text/template" href="project_panel.rml"/>
</head>
<body template="project_panel">
	<panel>
		<div class="content">
			<!-- Video Sources Section -->
			<div data-model="Sources">
				<h1>Add Tracking Volume</h1>
				<button class="icon-button" data-event-click="add_new_usb_video_source()"><img sprite="icon-usb"/></button>
				<button class="icon-button" data-event-click="add_new_network_video_source()"><img sprite="icon-network"/></button>
				<h1>Video Source</h1>
				<select id="select" name="select_source_id" data-value="selected_video_source_id" data-event-change="select_video_source_entry()">
					<option value="-1">-- None --</option>
					<option data-for="source_id : video_source_ids" data-value="source_id">{{source_id | to_video_source_friendly_name}}</option>
				</select>
				<div class="deletecomponent" data-if="selected_video_source_id != -1" data-event-click="remove_video_source()"></div>
			</div>

			<!-- USB Video Source Properties -->
			<div data-if="component_id != -1" data-model="USBVideoSourceComponent">
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>
						<tr class="property_tr">
							<td>
								<label>Name</label>
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="component_name"/>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Video Device</label>
								<label>{{desired_device_path | to_usb_camera_friendly_name}}</label>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Video Mode</label>
								<label>{{video_mode}}</label>
							</td>
						</tr>						
						<tr data-if="intrinsics_type == 0" class="property_tr">
							<td>
								<button data-event-click="calibrate_intrinsics()">Calibrate Intrinsics</button>
							</td>
						</tr>
						<tr data-if="intrinsics_type != 0" class="property_tr">
							<td>
								<button data-event-click="test_intrinsics()">Test Intrinsics</button>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<button data-event-click="show_video_source_settings()">Settings</button>
							</td>
						</tr>						
					</tbody>
				</table>
			</div>

			<!-- Network Video Source Properties -->
			<div data-if="component_id != -1" data-model="NetworkVideoSourceComponent">
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>
						<tr class="property_tr">
							<td>
								<label>Name</label>
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="component_name"/>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Protocol</label>
								<label>{{protocol}}</label>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>IP Address</label>
								<label>{{ip_address}}</label>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Port</label>
								<label>{{port}}</label>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Path</label>
								<label>{{path}}</label>
							</td>
						</tr>
						<tr data-if="intrinsics_type == 0" class="property_tr">
							<td>
								<button data-event-click="calibrate_intrinsics()">Calibrate Intrinsics</button>
							</td>
						</tr>
						<tr data-if="intrinsics_type != 0" class="property_tr">
							<td>
								<button data-event-click="test_intrinsics()">Test Intrinsics</button>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<button data-event-click="show_video_source_settings()">Settings</button>
							</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Texture Sources Section -->
			<div data-model="Sources">
				<h1>Add Texture Source</h1>
				<button class="icon-button" data-event-click="add_new_spout_texture_source()"><img sprite="icon-spout"/></button>
				<button class="icon-button" data-event-click="add_new_client_texture_source()"><img sprite="icon-mikan"/></button>
				<h1>Texture Source</h1>
				<select id="select" name="select_source_id" data-value="selected_texture_source_id" data-event-change="select_texture_source_entry()">
					<option value="-1">-- None --</option>
					<option data-for="source_id : texture_source_ids" data-value="source_id">{{source_id | to_texture_source_name}}</option>
				</select>
				<div class="deletecomponent" data-if="selected_texture_source_id != -1" data-event-click="remove_texture_source()"></div>
			</div>

			<!-- Client Texture Source Properties -->
			<div data-if="component_id != -1" data-model="ClientTextureSourceComponent">
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>
						<tr class="property_tr">
							<td>
								<label>Name</label>
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="component_name"/>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Source</label>
								<label>{{client_source}}</label>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<button data-event-click="show_texture_source_settings()">Settings</button>
							</td>
						</tr>
					</tbody>
				</table>
			</div>			

			<!-- Spout Texture Source Properties -->
			<div data-if="component_id != -1" data-model="SpoutTextureSourceComponent">
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>
						<tr class="property_tr">
							<td>
								<label>Name</label>
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="component_name"/>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<label>Source</label>
								<label>{{spout_source}}</label>
							</td>
						</tr>
						<tr class="property_tr">
							<td>
								<button data-event-click="show_texture_source_settings()">Settings</button>
							</td>
						</tr>
					</tbody>
				</table>
			</div>				
		</div>
	</panel>
</body>
</rml>
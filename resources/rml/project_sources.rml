<rml>
<head>
	<title>Project Sources</title>
	<link type="text/rcss" href="rml.rcss"/>
	<link type="text/rcss" href="mikan.rcss"/>
</head>
<body template="window">
	<panel>
		<div class="title-bar">
			<span class="title">Video Sources</span>
		</div>

		<div class="content">
			<!-- Video Sources Section -->
			<div data-model="VideoSources">
				<h3>Add Tracking Volume</h3>
				<button style="width: 60dp; height: 50dp; margin-right: -5dp;" data-event-click="add_new_usb_video_source()"><img sprite="icon-usb"/></button>
				<button style="width: 60dp; height: 50dp; margin-right: -5dp;" data-event-click="add_new_network_video_source()"><img sprite="icon-network"/></button>
				<button style="width: 60dp; height: 50dp; margin-right: -5dp;" data-event-click="add_new_spout_video_source()"><img sprite="icon-spout"/></button>
				<button style="width: 60dp; height: 50dp; margin-right: -5dp;" data-event-click="add_new_client_video_source()"><img sprite="icon-mikan"/></button>
				<h3>Video Source</h3>
				<select id="select" name="select_source_id" data-value="selected_video_source_id" data-event-change="select_video_source_entry()">
					<option data-for="source_id : video_source_ids" data-value="source_id">{{source_id | to_video_source_friendly_name}}</option>
				</select>
				<deletecomponent data-event-click="remove_video_source()"></deletecomponent>
			</div>

			<!-- Client Video Source Properties -->
			<div data-if="component_id != -1" data-model="ClientVideoSourceComponent">
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>
						<tr class="property_tr">
							<td>
								Name&nbsp;
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="component_name"/>
							</td>
						</tr>				
					</tbody>
				</table>
			</div>

			<!-- USB Video Source Properties -->
			<div data-if="component_id != -1" data-model="USBVideoSourceComponent">
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>
						<tr class="property_tr">
							<td>
								Name&nbsp;
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="component_name"/>
							</td>
						</tr>				
					</tbody>
				</table>
			</div>

			<!-- Network Video Source Properties -->
			<div data-if="component_id != -1" data-model="NetworkVideoSourceComponent">
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>
						<tr class="property_tr">
							<td>
								Name&nbsp;
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="component_name"/>
							</td>
						</tr>				
					</tbody>
				</table>
			</div>

			<!-- Spout Video Source Properties -->
			<div data-if="component_id != -1" data-model="SpoutVideoSourceComponent">
				<table>
					<thead>
						<tr><td style="margin-left: 10dp; margin-right: 0dp;"></td></tr>
					</thead>
					<tbody>
						<tr class="property_tr">
							<td>
								Name&nbsp;
								<input type="text" style="width: 150dp; margin-left: 0;	vertical-align: -2dp;" data-value="component_name"/>
							</td>
						</tr>				
					</tbody>
				</table>
			</div>				
		</div>
	</div>
</body>
</rml>
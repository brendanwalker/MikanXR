{
	"materialName":       "rgbaDepthKeyFrame",
	"vertexShaderPath":   "rgbaDepthKeyFrame.vert",
	"fragmentShaderPath": "rgbaDepthKeyFrame.frag",
	"vertexAttributes":   [
		{
			"name":     "aPos",
			"dataType": "vec2",
			"semantic": "position"
		},
		{
			"name":     "aTexCoords",
			"dataType": "vec2",
			"semantic": "texCoord"
		}
	],
	"uniformSemanticMap": {
		"depthTexture": "textureParam",
		"rgbaTexture":  "textureParam",
		"zThreshold":   "floatParam"
	},
	"domain":             "compositor",
	"vertexPreset":       "P2T",
	"sourceGraphPath":    "rgbaDepthKeyFrame.matgraph",
	"uniformDefaults":    {
		"zThreshold": 1.0
	}
}

{
	"materialName":       "shadowStrengthFrame",
	"vertexShaderPath":   "shadowStrengthFrame.vert",
	"fragmentShaderPath": "shadowStrengthFrame.frag",
	"vertexAttributes":   [
		{
			"name":     "aPos",
			"dataType": "vec2",
			"semantic": "position"
		},
		{
			"name":     "aTexCoords",
			"dataType": "vec2",
			"semantic": "texCoord"
		}
	],
	"uniformSemanticMap": {
		"rgbTexture":     "textureParam",
		"shadowStrength": "floatParam"
	},
	"domain":             "compositor",
	"vertexPreset":       "P2T",
	"sourceGraphPath":    "shadowStrengthFrame.matgraph",
	"uniformDefaults":    {
		"shadowStrength": 1.0,
		"rgbTexture":     "textures/missing_texture.png"
	}
}
